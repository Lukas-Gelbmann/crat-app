# Copy to .env.local and adjust. All variables are optional; defaults are shown.
# Never commit real secrets.

# LLM provider: "openai-compatible" (Ollama, LM Studio, ...) or "anthropic"
LLM_PROVIDER=openai-compatible

# OpenAI-compatible endpoint. Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
