# Copy to .env.local and adjust. All variables are optional; defaults are shown.
# Never commit real secrets.

# LLM provider: "openai-compatible" (Ollama, LM Studio, ...) or "anthropic"
LLM_PROVIDER=openai-compatible

# OpenAI-compatible endpoint. Ollama: http://localhost:11434/v1,
# LM Studio: http://localhost:1234/v1, OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434/v1

# Model name. Defaults: llama3.1:8b (openai-compatible), claude-opus-5-5 (anthropic)
LLM_MODEL=

# Bearer token for OpenAI-compatible endpoints that need one, e.g. OpenRouter
LLM_API_KEY=

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
